{
  "buildCommand": "python manage.py migrate --noinput && python manage.py seed_production_content && python manage.py collectstatic --noinput",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{assets/**,staticfiles/**,media/**,docs/**,shop/tests.py,**/__pycache__/**,*.sqlite3,*.log,.deploy-cache/**,.playwright-mcp/**,.codex-*.png}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
